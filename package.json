{
  "name": "dsh-idea-mcp-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JetBrains IDE MCP connector for DSH: discovers every running IntelliJ-family MCP endpoint and routes each session to the IDE project that matches its working directory.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "jetbrains",
    "intellij",
    "idea"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
